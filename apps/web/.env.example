# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by the daily history cleanup job.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Inference service (services/inference). URL printed by `modal deploy`; token = SPIKE_TOKEN from the Modal secret.
INFERENCE_URL=https://your-workspace--angelite-inference-api.modal.run
INFERENCE_TOKEN=change-me
# Set to true only once the inference service is deployed with a GPU (ANGELITE_GPU=T4).
VOICE_CLONING_ENABLED=false

# Any long random string. Vercel sends it with cron requests.
CRON_SECRET=change-me

# Public URL of the site, e.g. https://angelite.webrizen.com. Used for canonical URLs, the sitemap, social previews
# and email confirmation links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
